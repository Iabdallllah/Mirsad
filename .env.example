# Mirsad — environment variable template (plan.md §12).
# Placeholder names only. NEVER commit real values (AGENTS.md §4).
# Copy the relevant section into the platform secret store or a local,
# git-ignored .env file.

# ---------------------------------------------------------------------------
# Web (apps/web) — plan.md §12.1
# NOTE: SUPABASE_SERVICE_ROLE_KEY is intentionally NOT listed for web.
# plan.md §9.2–9.3 restricts the service role to API/worker; web uses the
# anon key + RLS + FastAPI. (Flagged doc inconsistency C2.)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_URL=
SENTRY_DSN=

# ---------------------------------------------------------------------------
# API (services/api) — plan.md §12.2
# ---------------------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
ENCRYPTION_KEY=
RESEND_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
API_BASE_URL=
APP_ENV=development

# ---------------------------------------------------------------------------
# Worker (services/worker) — plan.md §12.3 (shares API variables above)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
LITELLM_CONFIG_PATH=
SCAN_MAX_DURATION_MIN=15
SCAN_MAX_TOKENS=100000
SCAN_MAX_LLM_CALLS=25
SCAN_MAX_REQUESTS_SAFE=300
SCAN_MAX_REQUESTS_DEEP=600
WORKER_CONCURRENCY=2
WORKER_LEASE_TIMEOUT_SEC=120

# ---------------------------------------------------------------------------
# Mobile (apps/mobile) — plan.md §12.4 (Flutter track, later phase)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
